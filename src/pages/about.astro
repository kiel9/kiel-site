---
import Base from "../layouts/Base.astro";
import aboutRaw from "../../content/about.md?raw";
import positioningRaw from "../../content/positioning.md?raw";

// Copy comes from content/about.md verbatim, rendered as plain paragraphs.
const strip = (s: string) => s.replace(/<!--[\s\S]*?-->/g, "").trim();
const body = (raw: string) => strip(raw.replace(/^# .*\n/, ""));
const paragraphs = (s: string) => s.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const heading = aboutRaw.match(/^# (.+)$/m)?.[1].trim() ?? "About";
const paras = paragraphs(body(aboutRaw));

const shortName = positioningRaw.match(/^- Short[^:]*:\s*(.+)$/m)?.[1].trim() ?? "";
const linkedin = positioningRaw.match(/^- LinkedIn:\s*(.+)$/m)?.[1].trim() ?? "";
const email = positioningRaw.match(/^- Email:\s*(.+)$/m)?.[1].trim() ?? "";
const description =
  positioningRaw.match(/^## Meta description[^\n]*\n+([^\n]+)/m)?.[1].trim() ?? "";

// Closing line: the last paragraph already says "Reach me on LinkedIn or by email."
// Link those two words in place rather than appending a second contact line.
const last = paras[paras.length - 1] ?? "";
const linkable = last.includes("LinkedIn") && last.includes("email");
const bodyParas = linkable ? paras.slice(0, -1) : paras;
const closingHtml = linkable
  ? esc(last)
      .replace("LinkedIn", `<a href="${linkedin}">LinkedIn</a>`)
      .replace("email", `<a href="mailto:${email}">email</a>`)
  : "";
---

<Base title={`${heading} — ${shortName}`} description={description}>
  <article class="tile tile-prose">
  <h1>{heading}</h1>
  {bodyParas.map((p) => <p>{p}</p>)}
  {
    linkable ? (
      <p set:html={closingHtml} />
    ) : (
      <p>
        <a href={linkedin}>LinkedIn</a> · <a href={`mailto:${email}`}>{email}</a>
      </p>
    )
  }
  </article>
</Base>
