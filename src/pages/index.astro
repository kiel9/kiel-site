---
import Base from "../layouts/Base.astro";
import positioningRaw from "../../content/positioning.md?raw";
import caseStudyRaw from "../../content/case-study-claims-api.md?raw";
import nowRaw from "../../content/now.md?raw";

// --- Tiny markdown reader: copy comes from content/, never from this file. ---
const strip = (s: string) => s.replace(/<!--[\s\S]*?-->/g, "").trim();

/** Map of "## Heading" -> body text (comments removed). */
function sections(raw: string): Record<string, string> {
  const out: Record<string, string> = {};
  for (const part of raw.split(/^## /m).slice(1)) {
    const nl = part.indexOf("\n");
    out[part.slice(0, nl).trim()] = strip(part.slice(nl + 1));
  }
  return out;
}

/** First section whose heading starts with `prefix`. */
const pick = (map: Record<string, string>, prefix: string) =>
  map[Object.keys(map).find((k) => k.startsWith(prefix)) ?? ""] ?? "";

/** Text after the "# Title" line, comments removed. */
const body = (raw: string) => strip(raw.replace(/^# .*\n/, ""));

/** "# Title" line without the hash. */
const h1Of = (raw: string) => raw.match(/^# (.+)$/m)?.[1].trim() ?? "";

const paragraphs = (s: string) => s.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

// --- Positioning ---
const pos = sections(positioningRaw);
const headline = pick(pos, "Headline");
const subline = pick(pos, "Subline");
const metaDescription = pick(pos, "Meta description");
const shortName = pick(pos, "Name").match(/^- Short[^:]*:\s*(.+)$/m)?.[1].trim() ?? "";
const linkedin = pick(pos, "Links").match(/^- LinkedIn:\s*(.+)$/m)?.[1].trim() ?? "";
const email = pick(pos, "Links").match(/^- Email:\s*(.+)$/m)?.[1].trim() ?? "";

// Stat tiles: "- <figure> | <caption>" lines under "## Stats".
const stats = [...pick(pos, "Stats").matchAll(/^- (.+?) \| (.+)$/gm)].map((m) => ({
  figure: m[1].trim(),
  caption: m[2].trim(),
}));

// --- Case study ---
const cs = sections(caseStudyRaw);
const caseTitle = h1Of(caseStudyRaw);
const caseBlocks = [
  { label: "Problem", text: pick(cs, "Problem") },
  { label: "What I did", text: pick(cs, "What I did") },
  { label: "Outcome", text: pick(cs, "Outcome") },
];

// --- Now ---
const nowParagraphs = paragraphs(body(nowRaw));

const title = `${shortName} — ${headline}`;
---

<Base title={title} description={metaDescription}>
  <div class="bento">
    <section class="tile tile-hero" aria-labelledby="positioning">
      <h1 id="positioning">{headline}</h1>
      <p>{subline}</p>
      <p>
        <a href={linkedin}>LinkedIn</a> · <a href={`mailto:${email}`}>{email}</a>
      </p>
    </section>

    <div class="stats" role="list" aria-label="At a glance">
      {stats.map(({ figure, caption }) => (
        <div class="tile tile-stat" role="listitem">
          <span class="num">{figure}</span>
          <span class="cap">{caption}</span>
        </div>
      ))}
    </div>

    <section class="tile tile-case" aria-labelledby="selected-work">
      <p class="label" id="selected-work">Selected work</p>
      <article class="case">
        <h2>{caseTitle}</h2>
        {caseBlocks.map(({ label, text }) => (
          <div class="case-block">
            <h3>{label}</h3>
            {paragraphs(text).map((p) => <p>{p}</p>)}
          </div>
        ))}
      </article>
    </section>

    <div class="side">
      <section class="tile tile-now" aria-labelledby="now">
        <p class="label" id="now">Now</p>
        {nowParagraphs.map((p) => <p>{p}</p>)}
        <p><a href={linkedin}>Follow along on LinkedIn</a></p>
      </section>

      <section class="tile tile-contact" aria-labelledby="contact">
        <p class="label" id="contact">Contact</p>
        <a href={linkedin}>LinkedIn ↗</a>
        <a href={`mailto:${email}`}>Email ↗</a>
      </section>
    </div>
  </div>
</Base>
